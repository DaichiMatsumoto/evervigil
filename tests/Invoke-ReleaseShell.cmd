@echo off
setlocal EnableExtensions EnableDelayedExpansion

if "%~1"=="" exit /b 64

rem Capture only the reviewed release inputs. The EVERVIGIL_KEEP_ prefix is
rem private to this launcher and is removed before PowerShell starts.
set "EVERVIGIL_KEEP_GITHUB_WORKSPACE=!GITHUB_WORKSPACE!"
set "EVERVIGIL_KEEP_GITHUB_REF=!GITHUB_REF!"
set "EVERVIGIL_KEEP_GITHUB_SHA=!GITHUB_SHA!"
set "EVERVIGIL_KEEP_GITHUB_EVENT_NAME=!GITHUB_EVENT_NAME!"
set "EVERVIGIL_KEEP_GITHUB_EVENT_PATH=!GITHUB_EVENT_PATH!"
set "EVERVIGIL_KEEP_GITHUB_OUTPUT=!GITHUB_OUTPUT!"
set "EVERVIGIL_KEEP_GITHUB_ENV=!GITHUB_ENV!"
set "EVERVIGIL_KEEP_GITHUB_PATH=!GITHUB_PATH!"
set "EVERVIGIL_KEEP_GITHUB_STEP_SUMMARY=!GITHUB_STEP_SUMMARY!"
set "EVERVIGIL_KEEP_GITHUB_REPOSITORY=!GITHUB_REPOSITORY!"
set "EVERVIGIL_KEEP_GITHUB_RUN_ID=!GITHUB_RUN_ID!"
set "EVERVIGIL_KEEP_GITHUB_RUN_ATTEMPT=!GITHUB_RUN_ATTEMPT!"
set "EVERVIGIL_KEEP_GITHUB_JOB=!GITHUB_JOB!"
set "EVERVIGIL_KEEP_GITHUB_ACTION=!GITHUB_ACTION!"
set "EVERVIGIL_KEEP_GITHUB_WORKFLOW=!GITHUB_WORKFLOW!"
set "EVERVIGIL_KEEP_GITHUB_WORKFLOW_REF=!GITHUB_WORKFLOW_REF!"
set "EVERVIGIL_KEEP_GITHUB_WORKFLOW_SHA=!GITHUB_WORKFLOW_SHA!"
set "EVERVIGIL_KEEP_GITHUB_ACTOR=!GITHUB_ACTOR!"
set "EVERVIGIL_KEEP_GITHUB_TRIGGERING_ACTOR=!GITHUB_TRIGGERING_ACTOR!"
set "EVERVIGIL_KEEP_RUNNER_TEMP=!RUNNER_TEMP!"
set "EVERVIGIL_KEEP_RUNNER_ENVIRONMENT=!RUNNER_ENVIRONMENT!"
set "EVERVIGIL_KEEP_RUNNER_NAME=!RUNNER_NAME!"
set "EVERVIGIL_KEEP_RUNNER_OS=!RUNNER_OS!"
set "EVERVIGIL_KEEP_RUNNER_ARCH=!RUNNER_ARCH!"
set "EVERVIGIL_KEEP_RELEASE_EPHEMERAL=!EVERVIGIL_RELEASE_EPHEMERAL!"
set "EVERVIGIL_KEEP_RELEASE_SNAPSHOT_ID=!EVERVIGIL_RELEASE_SNAPSHOT_ID!"
set "EVERVIGIL_KEEP_PRODUCTION_AUDIT_HARNESS_SHA256=!PRODUCTION_AUDIT_HARNESS_SHA256!"
set "EVERVIGIL_KEEP_SHELL_RESULT=!EVERVIGIL_RELEASE_SHELL_RESULT!"
set "EVERVIGIL_KEEP_TEMP=!TEMP!"
set "EVERVIGIL_KEEP_TMP=!TMP!"
set "EVERVIGIL_KEEP_USERNAME=!USERNAME!"
set "EVERVIGIL_KEEP_USERDOMAIN=!USERDOMAIN!"
set "EVERVIGIL_KEEP_USERPROFILE=!USERPROFILE!"
set "EVERVIGIL_KEEP_HOMEDRIVE=!HOMEDRIVE!"
set "EVERVIGIL_KEEP_HOMEPATH=!HOMEPATH!"
set "EVERVIGIL_KEEP_APPDATA=!APPDATA!"
set "EVERVIGIL_KEEP_LOCALAPPDATA=!LOCALAPPDATA!"
set "EVERVIGIL_KEEP_COMPUTERNAME=!COMPUTERNAME!"
set "EVERVIGIL_KEEP_PROCESSOR_ARCHITECTURE=!PROCESSOR_ARCHITECTURE!"
set "EVERVIGIL_KEEP_PROCESSOR_IDENTIFIER=!PROCESSOR_IDENTIFIER!"
set "EVERVIGIL_KEEP_PROCESSOR_LEVEL=!PROCESSOR_LEVEL!"
set "EVERVIGIL_KEEP_PROCESSOR_REVISION=!PROCESSOR_REVISION!"
set "EVERVIGIL_KEEP_NUMBER_OF_PROCESSORS=!NUMBER_OF_PROCESSORS!"

rem Do not trust ComSpec or PATH while enumerating the inherited environment.
set "ComSpec=C:\Windows\System32\cmd.exe"
set "PATH=C:\Windows\System32;C:\Windows"
for /f "tokens=1 delims==" %%V in ('set') do (
  set "EVERVIGIL_ENV_NAME=%%V"
  if /i not "!EVERVIGIL_ENV_NAME:~0,15!"=="EVERVIGIL_KEEP_" set "!EVERVIGIL_ENV_NAME!="
)

rem Rebuild a minimal deterministic child environment. No arbitrary inherited
rem name can become an MSBuild property, NuGet plugin hook, CLR startup hook,
rem compiler path, or PowerShell module path.
set "SystemRoot=C:\Windows"
set "windir=C:\Windows"
set "ComSpec=C:\Windows\System32\cmd.exe"
set "OS=Windows_NT"
set "ProgramData=C:\ProgramData"
set "ProgramFiles=C:\Program Files"
set "ProgramW6432=C:\Program Files"
set "ProgramFiles(x86)=C:\Program Files (x86)"
set "CommonProgramFiles=C:\Program Files\Common Files"
set "CommonProgramW6432=C:\Program Files\Common Files"
set "CommonProgramFiles(x86)=C:\Program Files (x86)\Common Files"
set "PATH=C:\Program Files\dotnet;C:\Program Files\PowerShell\7;C:\Windows\System32;C:\Windows"
set "PATHEXT=.COM;.EXE;.BAT;.CMD"
set "PSModulePath=C:\Program Files\PowerShell\7\Modules;C:\Windows\System32\WindowsPowerShell\v1.0\Modules"
set "TEMP=!EVERVIGIL_KEEP_TEMP!"
set "TMP=!EVERVIGIL_KEEP_TMP!"
set "USERNAME=!EVERVIGIL_KEEP_USERNAME!"
set "USERDOMAIN=!EVERVIGIL_KEEP_USERDOMAIN!"
set "USERPROFILE=!EVERVIGIL_KEEP_USERPROFILE!"
set "HOMEDRIVE=!EVERVIGIL_KEEP_HOMEDRIVE!"
set "HOMEPATH=!EVERVIGIL_KEEP_HOMEPATH!"
set "APPDATA=!EVERVIGIL_KEEP_APPDATA!"
set "LOCALAPPDATA=!EVERVIGIL_KEEP_LOCALAPPDATA!"
set "COMPUTERNAME=!EVERVIGIL_KEEP_COMPUTERNAME!"
set "PROCESSOR_ARCHITECTURE=!EVERVIGIL_KEEP_PROCESSOR_ARCHITECTURE!"
set "PROCESSOR_IDENTIFIER=!EVERVIGIL_KEEP_PROCESSOR_IDENTIFIER!"
set "PROCESSOR_LEVEL=!EVERVIGIL_KEEP_PROCESSOR_LEVEL!"
set "PROCESSOR_REVISION=!EVERVIGIL_KEEP_PROCESSOR_REVISION!"
set "NUMBER_OF_PROCESSORS=!EVERVIGIL_KEEP_NUMBER_OF_PROCESSORS!"
set "GITHUB_ACTIONS=true"
set "CI=true"
set "GITHUB_WORKSPACE=!EVERVIGIL_KEEP_GITHUB_WORKSPACE!"
set "GITHUB_REF=!EVERVIGIL_KEEP_GITHUB_REF!"
set "GITHUB_SHA=!EVERVIGIL_KEEP_GITHUB_SHA!"
set "GITHUB_EVENT_NAME=!EVERVIGIL_KEEP_GITHUB_EVENT_NAME!"
set "GITHUB_EVENT_PATH=!EVERVIGIL_KEEP_GITHUB_EVENT_PATH!"
set "GITHUB_OUTPUT=!EVERVIGIL_KEEP_GITHUB_OUTPUT!"
set "GITHUB_ENV=!EVERVIGIL_KEEP_GITHUB_ENV!"
set "GITHUB_PATH=!EVERVIGIL_KEEP_GITHUB_PATH!"
set "GITHUB_STEP_SUMMARY=!EVERVIGIL_KEEP_GITHUB_STEP_SUMMARY!"
set "GITHUB_REPOSITORY=!EVERVIGIL_KEEP_GITHUB_REPOSITORY!"
set "GITHUB_RUN_ID=!EVERVIGIL_KEEP_GITHUB_RUN_ID!"
set "GITHUB_RUN_ATTEMPT=!EVERVIGIL_KEEP_GITHUB_RUN_ATTEMPT!"
set "GITHUB_JOB=!EVERVIGIL_KEEP_GITHUB_JOB!"
set "GITHUB_ACTION=!EVERVIGIL_KEEP_GITHUB_ACTION!"
set "GITHUB_WORKFLOW=!EVERVIGIL_KEEP_GITHUB_WORKFLOW!"
set "GITHUB_WORKFLOW_REF=!EVERVIGIL_KEEP_GITHUB_WORKFLOW_REF!"
set "GITHUB_WORKFLOW_SHA=!EVERVIGIL_KEEP_GITHUB_WORKFLOW_SHA!"
set "GITHUB_ACTOR=!EVERVIGIL_KEEP_GITHUB_ACTOR!"
set "GITHUB_TRIGGERING_ACTOR=!EVERVIGIL_KEEP_GITHUB_TRIGGERING_ACTOR!"
set "RUNNER_TEMP=!EVERVIGIL_KEEP_RUNNER_TEMP!"
set "RUNNER_ENVIRONMENT=!EVERVIGIL_KEEP_RUNNER_ENVIRONMENT!"
set "RUNNER_NAME=!EVERVIGIL_KEEP_RUNNER_NAME!"
set "RUNNER_OS=!EVERVIGIL_KEEP_RUNNER_OS!"
set "RUNNER_ARCH=!EVERVIGIL_KEEP_RUNNER_ARCH!"
set "EVERVIGIL_RELEASE_EPHEMERAL=!EVERVIGIL_KEEP_RELEASE_EPHEMERAL!"
set "EVERVIGIL_RELEASE_SNAPSHOT_ID=!EVERVIGIL_KEEP_RELEASE_SNAPSHOT_ID!"
set "PRODUCTION_AUDIT_HARNESS_SHA256=!EVERVIGIL_KEEP_PRODUCTION_AUDIT_HARNESS_SHA256!"
set "EVERVIGIL_RELEASE_SHELL_RESULT=!EVERVIGIL_KEEP_SHELL_RESULT!"

for /f "tokens=1 delims==" %%V in ('set EVERVIGIL_KEEP_ 2^>nul') do set "%%V="
set "EVERVIGIL_ENV_NAME="
setlocal DisableDelayedExpansion
set "EVERVIGIL_RELEASE_SCRIPT=%~f1"

"C:\Program Files\PowerShell\7\pwsh.exe" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$scriptPath = $env:EVERVIGIL_RELEASE_SCRIPT; [Environment]::SetEnvironmentVariable('EVERVIGIL_RELEASE_SCRIPT', $null, 'Process'); $env:PSModulePath = 'C:\Program Files\PowerShell\7\Modules;C:\Windows\System32\WindowsPowerShell\v1.0\Modules'; & $scriptPath"
exit /b %ERRORLEVEL%
